\par \hich\af2\dbch\af31505\loch\f2 COMPUTE stress5_r=6-stress5_calm.
\par \hich\af2\dbch\af31505\loch\f2 EXECUTE.
\par 
\par \hich\af2\dbch\af31505\loch\f2 COMPUTE stress_total=stress1 + stress2 + stress3 + stress4 + stress5_r.
\par \hich\af2\dbch\af31505\loch\f2 EXECUTE.
\par 
