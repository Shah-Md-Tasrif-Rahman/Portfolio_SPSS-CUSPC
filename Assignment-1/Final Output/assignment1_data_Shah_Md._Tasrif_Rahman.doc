\par }{\rtlch\fcs1 \af2 \ltrch\fcs0 \insrsid7144258 \hich\af2\dbch\af31505\loch\f2 * Encoding: UTF-8.
\par 
\par \hich\af2\dbch\af31505\loch\f2 * Messed this one up on the first time of submission, now Imma redo allat again ah.
\par 
\par \hich\af2\dbch\af31505\loch\f2 * Task-1 [Data importing/loading]:
\par 
\par \hich\af2\dbch\af31505\loch\f2 GET DATA
\par \hich\af2\dbch\af31505\loch\f2   /TYPE=XLSX
\par \hich\af2\dbch\af31505\loch\f2   /FILE='E:\\Statistical Softwares\\SPSS\\CUSPC-SPSS\\Assignments\\Assignment-1\\week1_data.xlsx'
\par \hich\af2\dbch\af31505\loch\f2   /SHEET=name 'Sheet1'
\par \hich\af2\dbch\af31505\loch\f2   /CELLRANGE=FULL
\par \hich\af2\dbch\af31505\loch\f2   /READNAMES=ON
\par \hich\af2\dbch\af31505\loch\f2   /DATATYPEMIN PERCENTAGE=95.0
\par \hich\af2\dbch\af31505\loch\f2   /HIDDEN IGNORE=YES.
\par \hich\af2\dbch\af31505\loch\f2 EXECUTE.
\par \hich\af2\dbch\af31505\loch\f2 DATASET NAME DataSet1 WINDOW=FRONT.
\par 
\par \hich\af2\dbch\af31505\loch\f2 * Task-2 [Data saving]:
\par 
\par \hich\af2\dbch\af31505\loch\f2 SAVE OUTFILE='E:\\Statistical Softwares\\SPSS\\CUSPC-SPSS\\Assignments\\Assignment-1\\assignment1_Shah_Md._Tasrif_Rahman\\assignment1_data_Shah_Md._Tasrif_Rahman.sav'
\par \hich\af2\dbch\af31505\loch\f2   /COMPRESSED.
\par 
\par \hich\af2\dbch\af31505\loch\f2 * Task-3 [Defining variables]:
\par 
\par \hich\af2\dbch\af31505\loch\f2 DATASET ACTIVATE DataSet1.
\par \hich\af2\dbch\af31505\loch\f2 * Define Variable Properties.
\par \hich\af2\dbch\af31505\loch\f2 *student_id.
\par \hich\af2\dbch\af31505\loch\f2 VARIABLE LEVEL  student_id(NOMINAL).
\par \hich\af2\dbch\af31505\loch\f2 VARIABLE LABELS  student_id 'Student identification number'.
\par 
\par \hich\af2\dbch\af31505\loch\f2 *gender.
\par \hich\af2\dbch\af31505\loch\f2 VARIABLE LABELS  gender 'Gender of respondent'.
\par \hich\af2\dbch\af31505\loch\f2 VALUE LABELS gender
\par \hich\af2\dbch\af31505\loch\f2   '1     ' 'Male'
\par \hich\af2\dbch\af31505\loch\f2   '2     ' 'Female'.
\par 
\par \hich\af2\dbch\af31505\loch\f2 * This following part is redundant since in the given dataset, the "faculty" column already has the names of the faculties, instead of numbers representing them.
\par 
\par \hich\af2\dbch\af31505\loch\f2 *faculty.
\par \hich\af2\dbch\af31505\loch\f2 *VARIABLE LABELS  faculty 'Faculty of enrolment'.
\par \hich\af2\dbch\af31505\loch\f2 *VALUE LABELS faculty
\par \hich\af2\dbch\af31505\loch\f2   'Science'      '1'
\par \hich\af2\dbch\af31505\loch\f2   'Business'    '2'
\par \hich\af2\dbch\af31505\loch\f2   'Arts'            '3'
\par \hich\af2\dbch\af31505\loch\f2   'Engineering' '4'.
\par 
\par \hich\af2\dbch\af31505\loch\f2 *year_of_study.
\par \hich\af2\dbch\af31505\loch\f2 VARIABLE LEVEL  year_of_study(SCALE).
\par \hich\af2\dbch\af31505\loch\f2 VARIABLE LABELS  year_of_study 'Current academic year'.
\par 
\par \hich\af2\dbch\af31505\loch\f2 *study_hours_week.
\par \hich\af2\dbch\af31505\loch\f2 VARIABLE LABELS  study_hours_week 'Self-reported study hours per week'.
\par 
\par \hich\af2\dbch\af31505\loch\f2 *sleep_hours.
\par \hich\af2\dbch\af31505\loch\f2 VARIABLE LABELS  sleep_hours 'Average hours of sleep per night'.
\par 
\par \hich\af2\dbch\af31505\loch\f2 *attendance_pct.
\par \hich\af2\dbch\af31505\loch\f2 VARIABLE LABELS  attendance_pct 'Class attendance (percentage)'.
\par 
\par \hich\af2\dbch\af31505\loch\f2 *stress1.
\par \hich\af2\dbch\af31505\loch\f2 VARIABLE LEVEL  stress1(ORDINAL).
\par \hich\af2\dbch\af31505\loch\f2 VARIABLE LABELS  stress1 'I feel overwhelmed by coursework'.
\par \hich\af2\dbch\af31505\loch\f2 VALUE LABELS stress1
\par \hich\af2\dbch\af31505\loch\f2   1 'Strongly disagree'
\par \hich\af2\dbch\af31505\loch\f2   2 'Disagree'
\par \hich\af2\dbch\af31505\loch\f2   3 'Neutral'
\par \hich\af2\dbch\af31505\loch\f2   4 'Agree'
\par \hich\af2\dbch\af31505\loch\f2   5 'Strongly agree'.
